{
    "name": "spolokh/telegram",
    "description": "Laravel-friendly Telegram Bot API wrapper using Http facade",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
        "name": "Jurgen Spolokh",
        "email": "yuryspolokh@ya.ru"
        }
    ],
    "keywords": ["laravel", "telegram", "bot", "api", "http"],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.30|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.50"
    },
    "autoload": {
        "psr-4": {
            "Spolokh\\Telegram\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spolokh\\Telegram\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=6",
        "fix": "php-cs-fixer fix --config=.php-cs-fixer.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.2"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}